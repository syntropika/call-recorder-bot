# Secret values for the environment variable names listed in config.toml [secrets].
DISCORD_TOKEN=replace-with-your-bot-token
# Set this only to enable transcription.
# TRANSCRIPTION_API_KEY=replace-with-your-transcription-api-key
# Required for the configured S3 provider.
S3_ACCESS_KEY_ID=replace-with-your-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-your-secret-access-key
# S3_SESSION_TOKEN=optional-temporary-session-token
