# Runtime values referenced by config.toml { env = "..." } sources.
DISCORD_TOKEN=replace-with-your-bot-token
# Set this only to enable transcription.
# TRANSCRIPTION_API_KEY=replace-with-your-transcription-api-key
# Required for the configured S3 provider.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=replace-with-your-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-your-secret-access-key
# S3_SESSION_TOKEN=optional-temporary-session-token
# Required when TRANSCRIPTION_API_KEY is set.
# TRANSCRIPTION_URL=https://your-provider.example/v1/audio/transcriptions
# Required when MCP is enabled with static_token authentication.
# Generate a random value, for example with: openssl rand -hex 32
# MCP_ACCESS_TOKEN=<generated-value>
